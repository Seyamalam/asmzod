{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "bench"]
}
